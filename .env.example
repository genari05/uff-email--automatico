# ================================
# SUPABASE
# ================================
# Painel Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a service_role key (NUNCA exponha no front-end / navegador)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ================================
# APP
# ================================
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=troque-por-uma-string-bem-grande-e-aleatoria
NODE_ENV=development

# ================================
# LEMBRETES AUTOMÁTICOS (cron)
# ================================
# Uma senha só sua, usada pelo serviço externo de cron (ex: cron-job.org)
# para acionar o envio de lembretes com segurança. Invente uma string grande.
CRON_SECRET=troque-por-outra-string-bem-grande-e-aleatoria

# ================================
# E-MAIL (Resend - via API, não SMTP)
# ================================
# Pegue sua chave em https://resend.com/api-keys (crie a conta antes)
RESEND_API_KEY=re_sua_chave_aqui

# Enquanto não verificar um domínio próprio no Resend, pode usar
# o remetente de testes deles, que já funciona pra qualquer destinatário:

