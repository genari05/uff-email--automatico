<aside class="sidebar">
  <div>
    <div class="sidebar-brand">
      <span class="dot-live"></span>
      Semana da Psicologia
    </div>

    <% if (typeof meusGtsSidebar !== 'undefined' && meusGtsSidebar.length > 0) { %>
      <div class="gt-switcher" title="Trocar de GT">
        <% meusGtsSidebar.forEach(m => { %>
          <a href="/gts/<%= m.gts.slug %>"
             class="gt-switcher-icone <%= currentPath.startsWith('/gts/' + m.gts.slug) ? 'ativo' : '' %>"
             style="--gt-color: <%= m.gts.color %>;"
             title="<%= m.gts.name %><%= m.role === 'leader' ? ' (líder)' : '' %>">
            <%= m.gts.name.replace('GT ', '').charAt(0).toUpperCase() %>
          </a>
        <% }) %>
        <a href="/gts" class="gt-switcher-icone gt-switcher-mais" title="Ver todos os GTs">+</a>
        <% if (typeof gtAtivo !== 'undefined' && gtAtivo) { %>
          <span class="gt-switcher-nome" style="--gt-color: <%= gtAtivo.color %>;">Vendo: <b><%= gtAtivo.name %></b></span>
        <% } else { %>
          <span class="gt-switcher-nome">Escolha um GT acima</span>
        <% } %>
      </div>
    <% } %>

    <% const gtBase = (typeof gtAtivoSlug !== 'undefined' && gtAtivoSlug) ? '/gts/' + gtAtivoSlug : '/gts'; %>
    <% const temGtAtivo = typeof gtAtivoSlug !== 'undefined' && !!gtAtivoSlug; %>
    <% const souLiderDoGtAtivo = typeof gtAtivoMembership !== 'undefined' && gtAtivoMembership && gtAtivoMembership.role === 'leader'; %>
    <nav class="sidebar-nav">
      <div class="sidebar-secao"><%= "Tarefas" %></div>
      <a href="/tarefas/minhas" class="<%= currentPath === '/tarefas/minhas' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="14" height="14" rx="2"/><path d="M6.5 10.2l2.2 2.2 4.8-4.8"/></svg>
        Minhas tarefas
      </a>
      <a href="<%= gtBase %>" class="<%= currentPath === gtBase ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 5h14M3 10h14M3 15h9"/></svg>
        Tarefas do GT
      </a>
      <a href="<%= temGtAtivo ? gtBase + '/tarefas/nova' : '/gts' %>" class="<%= temGtAtivo && currentPath === gtBase + '/tarefas/nova' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 4v12M4 10h12"/></svg>
        Nova tarefa
      </a>
      <% if (currentUser.role === 'leader') { %>
      <a href="/tarefas/desempenho" class="<%= currentPath === '/tarefas/desempenho' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 17V9M8.5 17V4M14 17v-6M17 17H3"/></svg>
        Desempenho
      </a>
      <% } %>
      <div class="sidebar-secao"><%= "Comunicação" %></div>
      <a href="/gts/central" class="<%= currentPath.startsWith('/gts/central') ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2.5 9.5c0-3.6 3.4-6 7.5-6s7.5 2.4 7.5 6-3.4 6-7.5 6c-.9 0-1.8-.1-2.6-.4L3 17l1-3.4c-.9-1-1.5-2.3-1.5-4.1z"/></svg>
        Mural central
      </a>
      <a href="/emails/selecionar" class="<%= currentPath.startsWith('/emails') ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2.5 5.5 10 11l7.5-5.5"/><rect x="2.5" y="4" width="15" height="12" rx="1.6"/></svg>
        Enviar e-mail
      </a>
      <% if (currentUser.role === 'leader') { %>
      <a href="/tarefas/lembretes" class="<%= currentPath === '/tarefas/lembretes' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6h12M4 10h12M4 14h8"/><circle cx="16" cy="15" r="2.4"/><path d="M15.2 15l.7.7 1.3-1.4"/></svg>
        Lembretes enviados
      </a>
      <% } %>
      <div class="sidebar-secao"><%= "Equipe" %></div>
      <a href="/gts" class="<%= currentPath === '/gts' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="2.5" width="6.5" height="6.5" rx="1.4"/><rect x="11" y="2.5" width="6.5" height="6.5" rx="1.4"/><rect x="2.5" y="11" width="6.5" height="6.5" rx="1.4"/><rect x="11" y="11" width="6.5" height="6.5" rx="1.4"/></svg>
        Grupos de Trabalho
      </a>
      <% if (currentUser.role === 'leader') { %>
      <a href="/pessoas" class="<%= currentPath === '/pessoas' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 17v-1.5a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3V17"/><circle cx="7" cy="6.5" r="3"/><path d="M17 17v-1.3a2.7 2.7 0 0 0-2-2.6"/><path d="M12 3.2a3 3 0 0 1 0 5.7"/></svg>
        Pessoas
      </a>
      <% } %>
      <% if (currentUser.role === 'leader' || (typeof meusGtsSidebar !== 'undefined' && meusGtsSidebar.some(m => m.role === 'leader'))) { %>
      <a href="/pedidos" class="<%= currentPath === '/pedidos' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="4" width="15" height="13" rx="1.6"/><path d="M2.5 8.5h15"/><path d="M6 12.2l2 2 4-4"/></svg>
        Pedidos
      </a>
      <% } %>
      <% if (currentUser.role !== 'leader') { %>
      <a href="/acesso/virar-lider" class="<%= currentPath === '/acesso/virar-lider' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 15.5 5 7l3.2 3.2L10 6l1.8 4.2L15 7l2 8.5z"/></svg>
        Virar líder
      </a>
      <% } %>
      <% if (currentUser.isTi) { %>
      <div class="sidebar-secao"><%= "Administração (TI)" %></div>
      <a href="/ti/gts" class="<%= currentPath === '/ti/gts' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8" cy="7" r="3"/><path d="M2.5 16.5c0-3 2.4-5 5.5-5s5.5 2 5.5 5"/><path d="M15 6v6M12 9h6"/></svg>
        Adicionar aos GTs
      </a>
      <a href="/tarefas" class="<%= currentPath === '/tarefas' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="10" r="3"/><path d="M1.5 10S5 4 10 4s8.5 6 8.5 6-3.5 6-8.5 6S1.5 10 1.5 10z"/></svg>
        Visão geral (tudo)
      </a>
      <% } %>
    </nav>
  </div>

  <div class="sidebar-blot" aria-hidden="true">
    <svg viewBox="0 0 200 240" class="blot-svg"></svg>
  </div>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <span class="sidebar-user-name"><%= currentUser.people.name %></span>
      <span class="sidebar-user-email"><%= currentUser.people.email %></span>
      <span class="badge <%= currentUser.role === 'leader' ? 'badge-lider' : '' %>" style="margin-top:4px; align-self:flex-start;">
        <%= currentUser.role === 'leader' ? 'Líder' : 'Membro' %>
      </span>
    </div>
    <a href="/auth/logout" class="sair">Sair da conta</a>
  </div>
</aside>
