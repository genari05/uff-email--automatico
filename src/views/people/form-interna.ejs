<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Cadastrar pessoa' }) %>

      <div class="app-content">
        <div class="card" style="max-width: 480px; margin: 0 auto;">
          <a href="/pessoas" class="voltar-link">← Voltar para a lista</a>

          <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>

          <form method="POST" action="/pessoas" class="form" style="max-width:none;">
            <label for="name">Nome completo</label>
            <input type="text" id="name" name="name" required autofocus>

            <label for="email">E-mail institucional</label>
            <input type="email" id="email" name="email" required>

            <button type="submit" style="margin-top: 12px;">Cadastrar</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
