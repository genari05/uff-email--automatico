<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Meu perfil' }) %>

      <div class="app-content perfil-content">
        <div class="card perfil-card">
          <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>
          <% if (sucesso) { %><p class="alerta alerta-sucesso"><%= sucesso %></p><% } %>

          <div class="avatar-editor">
            <div class="avatar-circle">
              <% if (pessoa.avatar_url) { %>
                <img src="<%= pessoa.avatar_url %>" alt="" class="avatar-preview-img">
              <% } else { %>
                <div class="avatar-preview-fallback"><%= pessoa.name.charAt(0).toUpperCase() %></div>
              <% } %>
            </div>
            <button type="button" class="avatar-camera-btn" id="btnEscolherArquivo" aria-label="Trocar foto de perfil">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M3 7.5a1.5 1.5 0 0 1 1.5-1.5h1.6l.8-1.4a1 1 0 0 1 .87-.5h4.46a1 1 0 0 1 .87.5l.8 1.4h1.6A1.5 1.5 0 0 1 17 7.5v7A1.5 1.5 0 0 1 15.5 16h-11A1.5 1.5 0 0 1 3 14.5v-7Z"/>
                <circle cx="10" cy="10.5" r="2.8"/>
              </svg>
            </button>
          </div>

          <div class="perfil-info">
            <strong><%= pessoa.name %></strong>
            <span class="stat-mono"><%= pessoa.email %></span>
            <span class="badge <%= currentUser.role === 'leader' ? 'badge-lider' : '' %>">
              <%= currentUser.role === 'leader' ? 'Líder' : 'Membro' %>
            </span>
          </div>

          <hr>
          <p style="text-align:center;"><a href="/pessoas/<%= pessoa.id %>/editar">Editar nome ou e-mail</a></p>

          <!-- Formulário real de envio (o JS preenche a foto já ajustada e envia) -->
          <form method="POST" action="/perfil/foto" enctype="multipart/form-data" id="avatarForm" hidden>
            <input type="file" name="foto" id="hiddenFotoInput">
          </form>

          <input type="file" id="fileInput" accept="image/*" hidden>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de ajuste da foto -->
  <div class="modal-overlay" id="cropModal" hidden>
    <div class="modal-box">
      <h3>Ajuste sua foto</h3>
      <p style="font-size:13px; color:var(--color-text-muted); margin-top:-8px;">Arraste pra posicionar dentro do círculo.</p>
      <div class="crop-mask" id="cropMask">
        <img id="cropImg" draggable="false" alt="">
      </div>
      <input type="range" id="zoomRange" min="1" max="2.5" step="0.01" value="1" class="zoom-range">
      <div class="modal-actions">
        <button type="button" class="btn-secundario" id="btnCancelarCrop">Cancelar</button>
        <button type="button" id="btnSalvarCrop">Salvar foto</button>
      </div>
    </div>
  </div>

  <script src="/js/avatar-editor.js" defer></script>
</body>
</html>
