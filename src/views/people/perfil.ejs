<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Meu perfil' }) %>

      <div class="app-content perfil-content">
        <div class="card perfil-card">
          <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>
          <% if (sucesso) { %><p class="alerta alerta-sucesso"><%= sucesso %></p><% } %>

          <div class="avatar-editor">
            <div class="avatar-circle" id="avatarPreviewWrap">
              <% if (pessoa.avatar_url) { %>
                <img src="<%= pessoa.avatar_url %>" alt="" id="avatarPreviewImg" class="avatar-preview-img">
              <% } else { %>
                <div id="avatarPreviewImg" class="avatar-preview-fallback"><%= pessoa.name.charAt(0).toUpperCase() %></div>
              <% } %>
            </div>
            <button type="button" class="avatar-camera-btn" id="btnAvatarMenu" aria-label="Trocar foto de perfil">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M3 7.5a1.5 1.5 0 0 1 1.5-1.5h1.6l.8-1.4a1 1 0 0 1 .87-.5h4.46a1 1 0 0 1 .87.5l.8 1.4h1.6A1.5 1.5 0 0 1 17 7.5v7A1.5 1.5 0 0 1 15.5 16h-11A1.5 1.5 0 0 1 3 14.5v-7Z"/>
                <circle cx="10" cy="10.5" r="2.8"/>
              </svg>
            </button>

            <div class="avatar-menu" id="avatarMenu" hidden>
              <button type="button" id="btnTirarFoto">📷 Tirar foto agora</button>
              <button type="button" id="btnEscolherArquivo">🖼️ Selecionar do dispositivo</button>
            </div>
          </div>

          <div class="perfil-info">
            <strong><%= pessoa.name %></strong>
            <span class="stat-mono"><%= pessoa.email %></span>
            <span class="badge <%= currentUser.role === 'leader' ? 'badge-lider' : '' %>">
              <%= currentUser.role === 'leader' ? 'Líder' : 'Membro' %>
            </span>
          </div>

          <hr>
          <p style="text-align:center;"><a href="/pessoas/<%= pessoa.id %>/editar">Editar nome ou e-mail</a></p>

          <!-- Formulário real de envio (o JS preenche o arquivo escolhido/capturado e envia direto) -->
          <form method="POST" action="/perfil/foto" enctype="multipart/form-data" id="avatarForm" hidden>
            <input type="file" name="foto" id="hiddenFotoInput">
          </form>

          <input type="file" id="fileInput" accept="image/*" hidden>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de câmera -->
  <div class="modal-overlay" id="cameraModal" hidden>
    <div class="modal-box">
      <h3>Tirar foto</h3>
      <video id="cameraVideo" autoplay playsinline class="camera-video"></video>
      <p id="cameraErro" class="alerta alerta-erro" hidden></p>
      <div class="modal-actions">
        <button type="button" class="btn-secundario" id="btnCancelarCamera">Cancelar</button>
        <button type="button" id="btnCapturar">Capturar</button>
      </div>
    </div>
  </div>

  <script src="/js/avatar-editor.js" defer></script>
</body>
</html>
