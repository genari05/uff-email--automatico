<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="auth-shell">
    <%- include('../partials/auth-panel', {
      heroTitle: sucesso ? 'E-mail confirmado.' : 'Algo não saiu como esperado.',
      heroText: sucesso ? 'Você já pode solicitar acesso ao painel quando quiser.' : 'Verifique o link ou peça um novo cadastro.'
    }) %>

    <div class="auth-form-side">
      <div class="auth-form-card">
        <span class="badge <%= sucesso ? 'badge-sucesso' : '' %>" style="margin-bottom: 16px;">
          <%= sucesso ? 'Verificado' : 'Link inválido' %>
        </span>
        <h1><%= sucesso ? 'E-mail confirmado' : 'Ops' %></h1>
        <p><%= mensagem %></p>

        <div class="auth-links">
          <a href="/auth/login">Ir para o login</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
