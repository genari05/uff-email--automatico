<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Editar tarefa' }) %>

      <div class="app-content">
        <div class="card" style="max-width: 640px; margin: 0 auto;">
          <a href="<%= voltar %>" class="voltar-link">← Voltar</a>
          <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>

          <% const val = (campo, padrao) => (v && v[campo] !== undefined ? v[campo] : padrao); %>
          <% const lembreteLigado = v ? v.sendReminder === 'on' : !!task.send_reminder; %>

          <form method="POST" action="/tarefas/<%= task.id %>/editar" class="form" style="max-width: none;">
            <label for="title">Título da tarefa</label>
            <input type="text" id="title" name="title" value="<%= val('title', task.title) %>" required>

            <label for="responsibleId">Responsável <span class="opcional-tag">trocar se foi pra pessoa errada</span></label>
            <select id="responsibleId" name="responsibleId" required>
              <% pessoas.forEach(p => { %>
                <option value="<%= p.id %>" <%= p.id === val('responsibleId', task.responsible_person_id) ? 'selected' : '' %>><%= p.name %></option>
              <% }) %>
            </select>

            <label for="description">Descrição (opcional)</label>
            <textarea id="description" name="description" rows="4"><%= val('description', task.description || '') %></textarea>

            <label for="deadlineDate">Prazo de entrega</label>
            <input type="date" id="deadlineDate" name="deadlineDate" value="<%= val('deadlineDate', String(task.deadline_date).slice(0, 10)) %>" required>

            <label for="status">Situação</label>
            <select id="status" name="status">
              <option value="pending" <%= val('status', task.status) !== 'completed' ? 'selected' : '' %>>Pendente</option>
              <option value="completed" <%= val('status', task.status) === 'completed' ? 'selected' : '' %>>Concluída</option>
            </select>

            <hr>

            <label class="checkbox-linha">
              <input type="checkbox" id="sendReminder" name="sendReminder" <%= lembreteLigado ? 'checked' : '' %>>
              Enviar um lembrete por e-mail automaticamente (opcional)
            </label>

            <div id="camposLembrete" style="display:<%= lembreteLigado ? 'block' : 'none' %>; margin-top: 12px;">
              <div class="campo-data-hora">
                <div>
                  <label for="reminderDate">Data do lembrete</label>
                  <input type="date" id="reminderDate" name="reminderDate" value="<%= val('reminderDate', task.reminder_date ? String(task.reminder_date).slice(0, 10) : '') %>">
                </div>
                <div>
                  <label for="reminderTime">Horário <span class="opcional-tag">opcional</span></label>
                  <input type="time" id="reminderTime" name="reminderTime" value="<%= val('reminderTime', task.reminder_time || '') %>">
                </div>
              </div>
              <small style="color: var(--color-text-muted); display: block; margin-top: 6px;">Se mudar a data ou o horário, o lembrete volta a valer e é enviado de novo.</small>

              <label for="reminderType" style="margin-top: 14px;">Tipo de e-mail do lembrete</label>
              <select id="reminderType" name="reminderType">
                <option value="custom" <%= val('reminderType', task.reminder_type) !== 'template' ? 'selected' : '' %>>Escrever um e-mail personalizado</option>
                <option value="template" <%= val('reminderType', task.reminder_type) === 'template' ? 'selected' : '' %>>Usar um modelo pronto</option>
              </select>

              <div id="campoTemplate" style="display:none;">
                <label for="reminderTemplateId">Modelo</label>
                <select id="reminderTemplateId" name="reminderTemplateId">
                  <option value="">Selecione um modelo</option>
                  <% templates.forEach(t => { %>
                    <option value="<%= t.id %>" <%= t.id === val('reminderTemplateId', task.reminder_template_id) ? 'selected' : '' %>><%= t.title %></option>
                  <% }) %>
                </select>
              </div>

              <div id="campoCustom">
                <label for="reminderSubject">Assunto do lembrete</label>
                <input type="text" id="reminderSubject" name="reminderSubject" value="<%= val('reminderSubject', task.reminder_subject || '') %>">

                <label for="reminderBody">Mensagem do lembrete</label>
                <textarea id="reminderBody" name="reminderBody" rows="5"><%= val('reminderBody', task.reminder_body || '') %></textarea>
              </div>
            </div>

            <button type="submit" style="margin-top: 16px;">Salvar alterações</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    const checkboxLembrete = document.getElementById('sendReminder');
    const camposLembrete = document.getElementById('camposLembrete');
    const tipoLembrete = document.getElementById('reminderType');
    const campoTemplate = document.getElementById('campoTemplate');
    const campoCustom = document.getElementById('campoCustom');

    checkboxLembrete.addEventListener('change', () => {
      camposLembrete.style.display = checkboxLembrete.checked ? 'block' : 'none';
    });

    function atualizarTipoLembrete() {
      const usaModelo = tipoLembrete.value === 'template';
      campoTemplate.style.display = usaModelo ? 'block' : 'none';
      campoCustom.style.display = usaModelo ? 'none' : 'block';
    }
    tipoLembrete.addEventListener('change', atualizarTipoLembrete);
    atualizarTipoLembrete();
  </script>
</body>
</html>
