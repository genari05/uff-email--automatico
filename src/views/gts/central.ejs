<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Mural e Atas' }) %>

      <div class="app-content">
        <div class="card">
          <div class="mural-abas" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;">
            <a href="/gts/central?ver=gt" class="<%= ver === 'gt' ? 'btn-primario-link' : 'btn-secundario' %>" style="padding:8px 16px; border-radius:999px; font-size:14px; <%= ver === 'gt' ? 'background:var(--color-primary); color:#fff; text-decoration:none;' : '' %>">Mural<%= (typeof gtAtivo !== 'undefined' && gtAtivo) ? ' · ' + gtAtivo.name : ' do meu GT' %></a>
            <a href="/gts/central?ver=atas" class="<%= ver === 'atas' ? 'btn-primario-link' : 'btn-secundario' %>" style="padding:8px 16px; border-radius:999px; font-size:14px; <%= ver === 'atas' ? 'background:var(--color-primary); color:#fff; text-decoration:none;' : '' %>">Atas GTs</a>
          </div>

          <% if (ver === 'gt') { %>
            <% if (typeof gtAtivo === 'undefined' || !gtAtivo) { %>
              <div class="empty-state">
                <div class="empty-state-icon">Ψ</div>
                <h3>Escolha um GT</h3>
                <p>Clique no ícone de um GT na barra lateral para ver o mural dele.</p>
              </div>
            <% } else if (atividades.length === 0) { %>
              <div class="empty-state">
                <div class="empty-state-icon">Ψ</div>
                <h3>Nada por aqui ainda</h3>
                <p>As atividades do <%= gtAtivo.name %> aparecem aqui.</p>
              </div>
            <% } else { %>
              <div class="mural-chat">
                <% atividades.slice().reverse().forEach((a) => { %>
                  <%
                    const pessoaMural = a.people;
                    const nomeMural = pessoaMural ? pessoaMural.name : 'Sistema';
                    const inicial = nomeMural.charAt(0).toUpperCase();
                    const classePapel = a.papel === 'leader' ? 'lider' : 'membro';
                  %>
                  <div class="mural-msg">
                    <% if (pessoaMural && pessoaMural.avatar_url) { %>
                      <img class="mural-avatar" src="<%= pessoaMural.avatar_url %>" alt="">
                    <% } else { %>
                      <div class="mural-avatar"><%= inicial %></div>
                    <% } %>
                    <div class="mural-msg-body">
                      <div class="mural-bubble <%= classePapel %>">
                        <span class="mural-nome"><%= nomeMural %></span>
                        <%= a.message %>
                        <small><%= new Date(a.created_at).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></small>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          <% } else { %>
          <p style="color: var(--color-text-muted);">Atas GTs: registros compartilhados entre todos os GTs — decisões, avisos e combinados.</p>

          <% if (meusGts.length === 0) { %>
            <div class="empty-state">
              <div class="empty-state-icon">Ψ</div>
              <h3>Você ainda não faz parte de nenhum GT</h3>
              <p>Peça entrada em um GT na tela de Grupos de Trabalho pra poder postar aqui.</p>
            </div>
          <% } else { %>
            <form method="POST" action="/gts/central" class="form" style="max-width:none; margin-bottom: 20px;">
              <% const gtAta = (typeof gtAtivo !== 'undefined' && gtAtivo) ? gtAtivo : (meusGts.length === 1 ? meusGts[0].gts : null); %>
              <% if (gtAta) { %>
                <input type="hidden" name="gtId" value="<%= gtAta.id %>">
                <p style="margin:0 0 8px;">A ata será registrada como:
                  <strong style="color: <%= gtAta.color %>;"><%= gtAta.name %></strong> ·
                  <strong><%= currentUser.people.name %></strong>
                </p>
              <% } else { %>
                <label for="gtId">GT que está registrando a ata</label>
                <select id="gtId" name="gtId" required>
                  <% meusGts.forEach(m => { %>
                    <option value="<%= m.gts.id %>"><%= m.gts.name %></option>
                  <% }) %>
                </select>
              <% } %>

              <label for="message">Ata</label>
              <textarea id="message" name="message" rows="3" required placeholder="Ex: reunião de quinta: definimos o cronograma de posts."></textarea>

              <button type="submit" style="margin-top:12px;">Registrar ata</button>
            </form>
          <% } %>

          <% if (mensagens.length === 0) { %>
            <div class="empty-state">
              <div class="empty-state-icon">Ψ</div>
              <h3>Nenhuma ata ainda</h3>
              <p>As atas registradas pelos GTs aparecem aqui.</p>
            </div>
          <% } else { %>
            <div class="mural-chat">
              <% mensagens.slice().reverse().forEach(m => { %>
                <%
                  const pessoa = m.users?.people;
                  const nome = pessoa ? pessoa.name : 'Sistema';
                  const inicial = nome.charAt(0).toUpperCase();
                %>
                <div class="mural-msg">
                  <% if (pessoa && pessoa.avatar_url) { %>
                    <img class="mural-avatar" src="<%= pessoa.avatar_url %>" alt="">
                  <% } else { %>
                    <div class="mural-avatar" style="background: <%= m.gts.color %>;"><%= inicial %></div>
                  <% } %>
                  <div class="mural-msg-body">
                    <div class="mural-bubble membro" style="border-color: <%= m.gts.color %>1a;">
                      <span class="mural-nome" style="color: <%= m.gts.color %>;"><%= m.gts.name %></span> ·
                      <span class="mural-nome"><%= nome %></span>
                      <%= m.message %>
                      <small><%= new Date(m.created_at).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %><% if (m.edited_at) { %> · editada<% } %></small>
                      <% const souAutor = m.author_user_id === currentUser.id; %>
                      <% { %>
                        <details class="msg-acoes">
                          <summary>Opções</summary>
                          <% { %>
                            <form method="POST" action="/gts/central/<%= m.id %>/editar" class="msg-editar">
                              <textarea name="message" rows="3" required><%= m.message %></textarea>
                              <button type="submit" style="padding:5px 12px; font-size:12px;">Salvar edição</button>
                            </form>
                          <% } %>
                          <form method="POST" action="/gts/central/<%= m.id %>/excluir" class="form-excluir-msg" style="display:inline;">
                            <button type="submit" class="btn-nao" style="padding:5px 12px; font-size:12px;">Excluir ata</button>
                          </form>
                        </details>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <script>
    document.querySelectorAll('.form-excluir-msg').forEach((f) => {
      f.addEventListener('submit', (e) => {
        if (!confirm('Excluir esta ata? Não dá para desfazer.')) e.preventDefault();
      });
    });
  </script>
</body>
</html>
