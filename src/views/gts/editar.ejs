<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Editar GT' }) %>

      <div class="app-content">
        <div class="card" style="max-width: 520px; margin: 0 auto;">
          <a href="/gts/<%= gt.slug %>" class="voltar-link">← Voltar</a>
          <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>

          <form method="POST" action="/gts/<%= gt.slug %>/editar" class="form" style="max-width:none;">
            <label for="name">Nome do GT</label>
            <input type="text" id="name" name="name" value="<%= gt.name %>" maxlength="60" required>

            <label for="description">Descrição</label>
            <textarea id="description" name="description" rows="3"><%= gt.description || '' %></textarea>

            <label for="color">Cor do GT</label>
            <input type="color" id="color" name="color" value="<%= gt.color %>" style="height:42px; width:80px; padding:2px;">

            <button type="submit" style="margin-top:16px;">Salvar alterações</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
