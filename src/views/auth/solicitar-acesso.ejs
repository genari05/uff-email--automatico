<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>

  <main class="container">
    <h1>Solicitar acesso</h1>
    <p>Digite o e-mail que você usou no cadastro (já verificado) para pedir acesso ao painel.</p>

    <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>
    <% if (sucesso) { %><p class="alerta alerta-sucesso"><%= sucesso %></p><% } %>

    <form method="POST" action="/acesso/solicitar" class="form">
      <label for="email">Seu e-mail institucional</label>
      <input type="email" id="email" name="email" required>
      <button type="submit">Enviar pedido</button>
    </form>

    <p><a href="/auth/login">Voltar para o login</a></p>
  </main>
</body>
</html>
