<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="auth-shell">
    <%- include('../partials/auth-panel', {
      heroTitle: 'Aconteceu com todo mundo.',
      heroText: 'Digite seu e-mail e a gente manda um link pra você criar uma senha nova.'
    }) %>

    <div class="auth-form-side">
      <div class="auth-form-card">
        <a href="/auth/login" class="voltar-link">← Voltar para o login</a>
        <h1>Esqueci minha senha</h1>

        <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>
        <% if (sucesso) { %><p class="alerta alerta-sucesso"><%= sucesso %></p><% } %>

        <% if (!sucesso) { %>
          <form method="POST" action="/auth/esqueci-senha" class="form">
            <label for="email">Seu e-mail institucional</label>
            <input type="email" id="email" name="email" required autofocus>
            <button type="submit">Enviar link</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
