<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="auth-shell">
    <%- include('../partials/auth-panel', {
      heroTitle: 'Bem-vindo de volta.',
      heroText: 'Entre com suas credenciais para acessar a lista de pessoas e enviar comunicados.'
    }) %>

    <div class="auth-form-side">
      <div class="auth-form-card">
        <h1>Entrar no sistema</h1>
        <p>Use o e-mail e a senha que você criou após ter seu acesso aprovado.</p>

        <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
          <p class="alerta alerta-sucesso"><%= mensagemSucesso %></p>
        <% } %>
        <% if (erro) { %>
          <p class="alerta alerta-erro"><%= erro %></p>
        <% } %>

        <form method="POST" action="/auth/login" class="form">
          <label for="email">E-mail institucional</label>
          <input type="email" id="email" name="email" required autofocus>

          <label for="password">Senha</label>
          <input type="password" id="password" name="password" required>

          <button type="submit">Entrar</button>
        </form>

        <div class="auth-links">
          <a href="/acesso/status">Já se cadastrou? Ver status do pedido</a>
          <a href="/pessoas/nova">Ainda não se cadastrou? Cadastrar E-mail</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
