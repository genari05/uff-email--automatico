<% if (typeof novidades !== 'undefined' && novidades) { %>
<div id="novidades-overlay" style="position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:9999; display:flex; align-items:center; justify-content:center; padding:16px;">
  <div role="dialog" aria-modal="true" aria-labelledby="novidades-titulo"
       style="background:var(--color-surface, #fff); color:var(--color-text, #222); max-width:560px; width:100%; max-height:88vh; overflow:auto; border-radius:14px; padding:22px 22px 18px; box-shadow:0 20px 60px rgba(0,0,0,.35);">
    <h2 id="novidades-titulo" style="margin-top:0;"><%= novidades.titulo %></h2>
    <ul style="padding-left:20px; margin:0 0 16px; line-height:1.5;">
      <% novidades.itens.forEach(i => { %><li style="margin-bottom:8px;"><%= i %></li><% }) %>
    </ul>
    <button type="button" id="novidades-ok">Entendi</button>
  </div>
</div>
<script>
  document.getElementById('novidades-ok').addEventListener('click', function () {
    document.getElementById('novidades-overlay').remove();
    try { fetch('/novidades/visto', { method: 'POST', credentials: 'same-origin' }); } catch (e) {}
  });
</script>
<% } %>
