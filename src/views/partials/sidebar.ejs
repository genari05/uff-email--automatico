<aside class="sidebar">
  <div>
    <div class="sidebar-brand">
      <span class="dot-live"></span>
      Sistema UFF
    </div>

    <nav class="sidebar-nav">
      <a href="/pessoas" class="<%= currentPath === '/pessoas' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 17v-1.5a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3V17"/><circle cx="7" cy="6.5" r="3"/><path d="M17 17v-1.3a2.7 2.7 0 0 0-2-2.6"/><path d="M12 3.2a3 3 0 0 1 0 5.7"/></svg>
        Pessoas
      </a>
      <a href="/perfil" class="<%= currentPath === '/perfil' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="7" r="3.2"/><path d="M4 17c0-3 2.7-5 6-5s6 2 6 5"/></svg>
        Meu perfil
      </a>
      <a href="/emails/selecionar" class="<%= currentPath.startsWith('/emails') ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2.5 5.5 10 11l7.5-5.5"/><rect x="2.5" y="4" width="15" height="12" rx="1.6"/></svg>
        Enviar e-mail
      </a>
      <a href="/tarefas/minhas" class="<%= currentPath === '/tarefas/minhas' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="14" height="14" rx="2"/><path d="M6.5 10.2l2.2 2.2 4.8-4.8"/></svg>
        Minhas tarefas
      </a>
      <a href="/tarefas" class="<%= currentPath === '/tarefas' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 5h14M3 10h14M3 15h9"/></svg>
        Painel de tarefas
      </a>
      <a href="/tarefas/nova" class="<%= currentPath === '/tarefas/nova' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 4v12M4 10h12"/></svg>
        Nova tarefa
      </a>
      <a href="/tarefas/lembretes" class="<%= currentPath === '/tarefas/lembretes' ? 'ativo' : '' %>">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6h12M4 10h12M4 14h8"/><circle cx="16" cy="15" r="2.4"/><path d="M15.2 15l.7.7 1.3-1.4"/></svg>
        Status de e-mails
      </a>
      <% if (currentUser.role === 'leader') { %>
        <a href="/acesso/pendentes" class="<%= currentPath === '/acesso/pendentes' ? 'ativo' : '' %>">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="4" width="15" height="13" rx="1.6"/><path d="M2.5 8.5h15"/><path d="M6 12.2l2 2 4-4"/></svg>
          Pedidos pendentes
        </a>
        <a href="/tarefas/aprovacao" class="<%= currentPath === '/tarefas/aprovacao' ? 'ativo' : '' %>">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 10.5l3.5 3.5L16 5.5"/></svg>
          Aprovar tarefas
        </a>
        <a href="/tarefas/desempenho" class="<%= currentPath === '/tarefas/desempenho' ? 'ativo' : '' %>">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 17V9M8.5 17V4M14 17v-6M17 17H3"/></svg>
          Desempenho da equipe
        </a>
      <% } else { %>
        <a href="/acesso/virar-lider" class="<%= currentPath === '/acesso/virar-lider' ? 'ativo' : '' %>">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 15.5 5 7l3.2 3.2L10 6l1.8 4.2L15 7l2 8.5z"/></svg>
          Virar líder
        </a>
      <% } %>
    </nav>
  </div>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <span class="sidebar-user-name"><%= currentUser.people.name %></span>
      <span class="sidebar-user-email"><%= currentUser.people.email %></span>
      <span class="badge <%= currentUser.role === 'leader' ? 'badge-lider' : '' %>" style="margin-top:4px; align-self:flex-start;">
        <%= currentUser.role === 'leader' ? 'Líder' : 'Membro' %>
      </span>
    </div>
    <a href="/auth/logout" class="sair">Sair da conta</a>
  </div>
</aside>
