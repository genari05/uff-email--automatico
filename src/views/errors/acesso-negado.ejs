<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="auth-shell">
    <%- include('../partials/auth-panel', {
      heroTitle: 'Acesso restrito.',
      heroText: 'Essa área é reservada para o líder do sistema.'
    }) %>

    <div class="auth-form-side">
      <div class="auth-form-card">
        <span class="badge" style="margin-bottom: 16px; border-color:#F1C1C8; color: var(--color-danger); background: var(--color-danger-bg);">Acesso negado</span>
        <h1>Sem permissão</h1>
        <p><%= mensagem %></p>

        <div class="auth-links">
          <a href="/auth/login">Voltar para o login</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
