<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Pedidos' }) %>

      <div class="app-content" style="display:flex; flex-direction:column; gap:24px;">
        <% if (pedidosGt.length > 0 || !ehLiderGlobal) { %>
        <div class="card">
          <h2 style="margin-top:0;">Entrada nos GTs</h2>

          <% if (pedidosGt.length === 0) { %>
            <div class="empty-state">
              <div class="empty-state-icon">Ψ</div>
              <h3>Nenhum pedido pendente</h3>
              <p>Quando alguém pedir entrada em um GT que você lidera, aparece aqui.</p>
            </div>
          <% } else { %>
            <ul class="lista-pedidos">
              <% pedidosGt.forEach(p => { %>
                <li class="card-pedido">
                  <div>
                    <strong><%= p.users?.people?.name %></strong>
                    <span class="badge" style="background: <%= p.gts.color %>1a; color: <%= p.gts.color %>; border: none;"><%= p.gts.name %></span>
                    <br>
                    <span><%= p.users?.people?.email %></span>
                  </div>
                  <div class="acoes-pedido">
                    <form method="POST" action="/gts/pendentes/<%= p.id %>/resolver" style="display:inline">
                      <input type="hidden" name="decisao" value="approved">
                      <button type="submit" class="btn-sim">Aprovar</button>
                    </form>
                    <form method="POST" action="/gts/pendentes/<%= p.id %>/resolver" style="display:inline">
                      <input type="hidden" name="decisao" value="denied">
                      <button type="submit" class="btn-nao">Negar</button>
                    </form>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
        <% } %>
        <% if (ehLiderGlobal) { %>
        <div class="card">
          <h2 style="margin-top:0;">Acesso ao site</h2>

          <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>

          <% if (pedidosAcesso.length === 0) { %>
            <div class="empty-state">
              <div class="empty-state-icon">Ψ</div>
              <h3>Nenhum pedido de acesso pendente</h3>
              <p>Quando alguém se cadastrar, o pedido de acesso aparece aqui automaticamente pra você avaliar.</p>
            </div>
          <% } else { %>
            <ul class="lista-pedidos">
              <% pedidosAcesso.forEach(pedido => { %>
                <li class="card-pedido">
                  <div>
                    <strong><%= pedido.people.name %></strong>
                    <span class="badge <%= pedido.people.verified ? 'badge-sucesso' : 'badge-pendente' %>" style="margin-left: 8px;">
                      <%= pedido.people.verified ? 'e-mail verificado' : 'e-mail não verificado' %>
                    </span><br>
                    <span class="stat-mono"><%= pedido.people.email %></span><br>
                    <small>Pedido em <%= new Date(pedido.requested_at).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></small>
                  </div>
                  <div class="acoes-pedido">
                    <% if (pedido.people.verified) { %>
                      <form method="POST" action="/acesso/<%= pedido.id %>/resolver" style="display:inline">
                        <input type="hidden" name="decisao" value="approved">
                        <button type="submit" class="btn-sim">Aprovar</button>
                      </form>
                    <% } else { %>
                      <span class="btn-locked" title="Aguardando a pessoa confirmar o e-mail">
                        🔒 Aguardando e-mail
                      </span>
                      <form method="POST" action="/pessoas/<%= pedido.people.id %>/reenviar-verificacao" style="display:inline">
                        <button type="submit" class="btn-secundario" style="padding:6px 10px; font-size:12px;">Reenviar e-mail</button>
                      </form>
                    <% } %>
                    <form method="POST" action="/acesso/<%= pedido.id %>/resolver" style="display:inline">
                      <input type="hidden" name="decisao" value="denied">
                      <button type="submit" class="btn-nao">Negar</button>
                    </form>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>

        <div class="card">
          <h2 style="margin-top:0;">Virar líder</h2>
          <% if (pedidosLider.length === 0) { %>
            <div class="empty-state">
              <div class="empty-state-icon">Ψ</div>
              <h3>Nenhum pedido de promoção pendente</h3>
              <p>Quando um membro pedir pra virar líder, o pedido aparece aqui.</p>
            </div>
          <% } else { %>
            <ul class="lista-pedidos">
              <% pedidosLider.forEach(pedido => { %>
                <li class="card-pedido">
                  <div>
                    <strong><%= pedido.people.name %></strong>
                    <span class="badge badge-lider" style="margin-left: 8px;">quer virar líder</span><br>
                    <span class="stat-mono"><%= pedido.people.email %></span><br>
                    <small>Pedido em <%= new Date(pedido.requested_at).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></small>
                  </div>
                  <div class="acoes-pedido">
                    <form method="POST" action="/acesso/<%= pedido.id %>/resolver" style="display:inline">
                      <input type="hidden" name="decisao" value="approved">
                      <button type="submit" class="btn-sim">Aprovar</button>
                    </form>
                    <form method="POST" action="/acesso/<%= pedido.id %>/resolver" style="display:inline">
                      <input type="hidden" name="decisao" value="denied">
                      <button type="submit" class="btn-nao">Negar</button>
                    </form>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
