<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Resultado do envio' }) %>

      <div class="app-content">
        <div class="card" style="max-width: 480px; margin: 0 auto;">
          <% if (erro) { %>
            <p class="alerta alerta-erro"><%= erro %></p>
          <% } else { %>
            <p class="alerta alerta-sucesso"><%= resultado.success %> e-mail(s) enviado(s) com sucesso.</p>
            <% if (resultado.failed > 0) { %>
              <p class="alerta alerta-erro"><%= resultado.failed %> e-mail(s) falharam.</p>
            <% } %>
          <% } %>

          <div class="auth-links" style="margin-top: 0;">
            <a href="/emails/selecionar">Enviar outro e-mail</a>
            <a href="/pessoas">Voltar para pessoas</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
