<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Editar modelo de e-mail' }) %>

      <div class="app-content">
        <div class="card" style="max-width: 640px; margin: 0 auto;">
          <a href="/emails/tipo" class="voltar-link">← Voltar</a>
          <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>

          <form method="POST" action="/emails/templates/<%= t.id %>/editar" class="form" style="max-width:none;">
            <label for="title">Nome do modelo</label>
            <input type="text" id="title" name="title" value="<%= t.title %>" required>

            <label for="subject">Assunto</label>
            <input type="text" id="subject" name="subject" value="<%= t.subject %>" required>

            <label for="body">Corpo do e-mail</label>
            <textarea id="body" name="body" rows="8" required><%= t.body %></textarea>

            <button type="submit" style="margin-top:16px;">Salvar alterações</button>
          </form>

          <form method="POST" action="/emails/templates/<%= t.id %>/excluir" id="formExcluirModelo" style="margin-top:16px;">
            <button type="submit" class="btn-nao">Excluir este modelo</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script>
    document.getElementById('formExcluirModelo').addEventListener('submit', (e) => {
      if (!confirm('Excluir este modelo? Lembretes que usam ele podem deixar de funcionar.')) e.preventDefault();
    });
  </script>
</body>
</html>
