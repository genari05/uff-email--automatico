<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>

  <main class="container">
    <h1>Pedidos de acesso pendentes</h1>

    <% if (pedidos.length === 0) { %>
      <p>Nenhum pedido pendente no momento. 🎉</p>
    <% } %>

    <ul class="lista-pedidos">
      <% pedidos.forEach(pedido => { %>
        <li class="card-pedido">
          <div>
            <strong><%= pedido.people.name %></strong><br>
            <span><%= pedido.people.email %></span><br>
            <small>Pedido em <%= new Date(pedido.requested_at).toLocaleString('pt-BR') %></small>
          </div>
          <div class="acoes-pedido">
            <form method="POST" action="/acesso/<%= pedido.id %>/resolver" style="display:inline">
              <input type="hidden" name="decisao" value="approved">
              <button type="submit" class="btn-sim">Sim</button>
            </form>
            <form method="POST" action="/acesso/<%= pedido.id %>/resolver" style="display:inline">
              <input type="hidden" name="decisao" value="denied">
              <button type="submit" class="btn-nao">Não</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  </main>
</body>
</html>
