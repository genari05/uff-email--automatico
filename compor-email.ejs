<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/app-topbar', { pageTitle: 'Compor e-mail' }) %>

      <div class="app-content">
        <div class="card" style="max-width: 620px; margin: 0 auto;">
          <a href="/emails/tipo?ids=<%= ids.join(',') %>" class="voltar-link">← Voltar</a>
          <p style="margin-bottom: 20px;">
            Destinatários (<%= pessoas.length %>):
            <span class="stat-mono">
              <% pessoas.forEach((p, i) => { %><%= p.name %><%= i < pessoas.length - 1 ? ', ' : '' %><% }) %>
            </span>
          </p>

          <form method="POST" action="/emails/enviar" class="form" style="max-width: none;">
            <% ids.forEach(id => { %>
              <input type="hidden" name="ids" value="<%= id %>">
            <% }) %>

            <input type="hidden" name="tipo" value="<%= template ? 'template' : 'custom' %>">
            <% if (template) { %>
              <input type="hidden" name="templateId" value="<%= template.id %>">
            <% } %>

            <label for="subject">Assunto</label>
            <input type="text" id="subject" name="subject" value="<%= template ? template.subject : '' %>" required>

            <label for="body">Mensagem</label>
            <textarea id="body" name="body" rows="10" required><%= template ? template.body : '' %></textarea>

            <button type="submit">Enviar e-mail</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
