<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>

  <main class="container">
    <h1>Entrar no sistema</h1>

    <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
      <p class="alerta alerta-sucesso"><%= mensagemSucesso %></p>
    <% } %>
    <% if (erro) { %>
      <p class="alerta alerta-erro"><%= erro %></p>
    <% } %>

    <form method="POST" action="/auth/login" class="form">
      <label for="email">E-mail institucional</label>
      <input type="email" id="email" name="email" required>

      <label for="password">Senha</label>
      <input type="password" id="password" name="password" required>

      <button type="submit">Entrar</button>
    </form>

    <p>Ainda não tem acesso? <a href="/acesso/solicitar">Solicitar acesso</a></p>
    <p>Já pediu acesso? <a href="/acesso/status">Ver status do pedido</a></p>
  </main>
</body>
</html>
