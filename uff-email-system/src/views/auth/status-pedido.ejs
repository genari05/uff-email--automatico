<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>

  <main class="container">
    <h1>Status do seu pedido de acesso</h1>

    <form method="GET" action="/acesso/status/consultar" class="form">
      <label for="email">Seu e-mail institucional</label>
      <input type="email" id="email" name="email" required>
      <button type="submit">Consultar</button>
    </form>

    <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>

    <% if (resultado) { %>
      <% if (resultado.status === 'nenhum') { %>
        <p class="alerta">Você ainda não fez nenhum pedido de acesso.</p>
      <% } else if (resultado.status === 'pending') { %>
        <p class="alerta">Seu pedido está <b>pendente</b>, aguardando análise do líder.</p>
      <% } else if (resultado.status === 'approved') { %>
        <p class="alerta alerta-sucesso">Seu pedido foi <b>aprovado</b>! Confira seu e-mail para criar sua senha.</p>
      <% } else if (resultado.status === 'denied') { %>
        <p class="alerta alerta-erro">🚫 Acesso negado. Seu pedido não foi aprovado pelo líder. Você pode solicitar novamente.</p>
      <% } %>
    <% } %>

    <p><a href="/auth/login">Voltar para o login</a></p>
  </main>
</body>
</html>
