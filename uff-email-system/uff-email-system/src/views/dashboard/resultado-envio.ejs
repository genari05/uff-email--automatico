<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>

  <main class="container">
    <h1>Resultado do envio</h1>

    <% if (erro) { %>
      <p class="alerta alerta-erro"><%= erro %></p>
    <% } else { %>
      <p class="alerta alerta-sucesso">✅ <%= resultado.success %> e-mail(s) enviado(s) com sucesso.</p>
      <% if (resultado.failed > 0) { %>
        <p class="alerta alerta-erro">⚠️ <%= resultado.failed %> e-mail(s) falharam.</p>
      <% } %>
    <% } %>

    <p><a href="/emails/selecionar">Enviar outro e-mail</a></p>
    <p><a href="/pessoas">Voltar para pessoas</a></p>
  </main>
</body>
</html>
