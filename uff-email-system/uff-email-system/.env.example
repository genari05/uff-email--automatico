# ================================
# SUPABASE
# ================================
# Painel Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a service_role key (NUNCA exponha no front-end / navegador)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ================================
# APP
# ================================
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=troque-por-uma-string-bem-grande-e-aleatoria
NODE_ENV=development

# ================================
# E-MAIL (SMTP - ex: Gmail, Outlook, SendGrid, etc)
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
EMAIL_FROM="Sistema UFF <seu-email@gmail.com>"
