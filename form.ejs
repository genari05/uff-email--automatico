<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
  <div class="auth-shell">
    <%- include('../partials/auth-panel', {
      heroTitle: 'Cadastre uma pessoa na rede.',
      heroText: 'Todo cadastro passa por verificação de e-mail antes de poder receber comunicados.'
    }) %>

    <div class="auth-form-side">
      <div class="auth-form-card">
        <a href="javascript:history.back()" class="voltar-link">← Voltar</a>
        <h1>Cadastrar pessoa</h1>
        <p>Preencha os dados abaixo. Um e-mail de confirmação será enviado.</p>

        <% if (erro) { %><p class="alerta alerta-erro"><%= erro %></p><% } %>

        <form method="POST" action="/pessoas" class="form">
          <label for="name">Nome completo</label>
          <input type="text" id="name" name="name" required autofocus>

          <label for="email">E-mail institucional (@id.uff.br)</label>
          <input type="email" id="email" name="email" required>

          <button type="submit">Cadastrar</button>
        </form>

        <div class="auth-links">
          <a href="/auth/login">Já tem acesso? Fazer login</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
